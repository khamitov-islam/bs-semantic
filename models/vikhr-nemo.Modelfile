# Vikhr-Nemo-Instruct-R использует llama3-подобные заголовки как обычный текст,
# а не спецтокены Llama 3. Автоопределение Ollama (`llama3-instruct`) вставляет
# <|eot_id|>, которого в этом GGUF нет — ответы получаются пустыми или ломаными.
FROM /tmp/bsrag_models/vikhr-nemo-12b-instruct-r-21-09-24-q4_k_m.gguf

TEMPLATE """{{- range .Messages }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}
{{ end }}<|start_header_id|>assistant<|end_header_id|>

"""

PARAMETER num_ctx 8192
PARAMETER temperature 0.1
PARAMETER stop <|start_header_id|>
PARAMETER stop <|end_header_id|>
